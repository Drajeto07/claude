# Copy to .env.local for development.

# The API as the browser reaches it. Built into the pages (and the
# Content-Security-Policy) at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Where the frontend's own server reaches the API, when that isn't the address
# above (e.g. http://backend:8000 inside a container network). Read at run time,
# never sent to the browser. Leave unset otherwise.
# API_INTERNAL_URL=
