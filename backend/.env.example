AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
CORS_ORIGINS=http://localhost:3000
# Supabase: dashboard -> Connect -> Session pooler (NOT the port-6543 transaction
# pooler). Paste it as shown; app/config.py switches it to the asyncpg driver and
# adds ssl=require for any non-local host.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres
# Asset storage: "local" (files under backend/data/assets) or "s3" (any S3-compatible
# service). Supabase Storage: endpoint https://[PROJECT-REF].storage.supabase.co/storage/v1/s3,
# region = the project's region, keys from dashboard -> Storage -> S3 (server-side only).
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Undo steps kept per document, and saved versions kept per template (both default 50).
# DOCUMENT_HISTORY_MAX_STEPS=50
# TEMPLATE_HISTORY_MAX_VERSIONS=50
# Extra folders with .ttf fonts for PDF export, searched before the system font folders
# (separate several with ; on Windows, : elsewhere). A Linux server needs e.g. fonts-dejavu.
# PDF_FONT_DIRS=
# Background jobs (imports, formatting, exports, Format by Example): "background" runs
# them in the API process (development: a restart fails the ones running); "arq" hands
# them to an arq worker through Redis (production: run `arq app.worker.WorkerSettings`
# with the same .env, and set REDIS_URL on the API servers and the worker).
JOB_BACKEND=background
# REDIS_URL=redis://localhost:6379
# How long a finished export stays downloadable, and how long job records are kept.
# JOB_FILE_TTL_HOURS=24
# JOB_RETENTION_DAYS=7
# Plans and billing (app/billing/plans.json holds the plans and their limits; the
# limits apply with or without Stripe). Without STRIPE_SECRET_KEY nobody can subscribe
# and the billing page says so. Keys: Stripe dashboard -> Developers -> API keys (the
# secret key, server-side only). Webhook: add an endpoint at
# <backend URL>/api/billing/webhook for checkout.session.completed and
# customer.subscription.* events, and paste its signing secret. Prices: one recurring
# price per paid plan, its id (price_...) under STRIPE_PRICE_<PLAN KEY>.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_BUSINESS=
# Where Stripe sends the user back to after checkout or the billing portal.
# FRONTEND_URL=http://localhost:3000
# The server's own cap on an uploaded file (no plan takes a larger one), and on any
# request body at all (refused with 413 before it is read; must be the larger).
# MAX_UPLOAD_SIZE_MB=10
# MAX_REQUEST_SIZE_MB=25
# How long one AI call may take before it counts as failed (the task falls back).
# AI_TIMEOUT_SECONDS=180
# Rate limits, "<count>/<second|minute|hour|day>" (empty = off). Counted in this
# process's memory; with several API processes set RATE_LIMIT_BACKEND=redis (REDIS_URL).
# RATE_LIMIT_BACKEND=memory
# RATE_LIMIT_GLOBAL=600/minute
# RATE_LIMIT_LOGIN=20/minute
# RATE_LIMIT_LOGIN_ACCOUNT=10/minute
# RATE_LIMIT_REGISTER=10/hour
# RATE_LIMIT_AI=20/minute
# RATE_LIMIT_UPLOAD=20/minute
# RATE_LIMIT_EXPORT=30/minute
# Logs: LOG_FORMAT=json for a log collector, LOG_REQUESTS=true for one line per request
# (then run uvicorn with --no-access-log). Behind a proxy, run uvicorn with
# --proxy-headers --forwarded-allow-ips=<the proxy's address> so limits and audit
# lines see the real client address.
# LOG_LEVEL=INFO
# LOG_FORMAT=text
# LOG_REQUESTS=false
# Strict-Transport-Security, in seconds (only when the API is served over HTTPS alone).
# HSTS_SECONDS=0
